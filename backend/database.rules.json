{
  "rules": {
    "telemetry": {
      "$vehicleId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['lat', 'lng', 'timestamp'])"
      }
    },
    "corridors": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role == 'ADMIN' || auth.token.role == 'SYSTEM')"
    },
    "pole_live_states": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "gateway_queue": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
